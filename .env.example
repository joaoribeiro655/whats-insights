# Segredos compartilhados entre os serviços (gere com: openssl rand -hex 32)
GATEWAY_TOKEN=
INGEST_SECRET=
JOBS_SECRET=
# Criptografa a chave da Anthropic salva na tela de Configurações
APP_SECRET=
POSTGRES_PASSWORD=postgres

# Análise com Claude. A chave é colada na tela Configurações da plataforma; esta variável é só um fallback opcional.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
ANALYZE_INACTIVITY_MINUTES=120

# Regras de negócio
STALLED_AFTER_MINUTES=60
TIMEZONE=America/Sao_Paulo
BUSINESS_HOURS_START=8
BUSINESS_HOURS_END=18
RETENTION_DAYS=180

# Gateway
DEVICE_NAME=Insights
SYNC_FULL_HISTORY=false
WEB_PORT=3000
